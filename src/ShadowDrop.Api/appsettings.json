{
  "ShadowDrop": {
    "Metadata": {
      "Provider": "LiteDb",
      "LiteDbPath": "data/metadata/shadowdrop.db"
    },
    "Storage": {
      "Provider": "FileSystem",
      "LocalRoot": "data/storage",
      "GridFsBucketName": "shadowdrop_blobs",
      "S3": {
        "BucketName": "",
        "Region": "",
        "ServiceEndpoint": "",
        "KeyPrefix": "",
        "UsePathStyle": false
      }
    },
    "Mongo": {
      "ConnectionString": "",
      "DatabaseName": "shadowdrop"
    },
    "ApiExposure": {
      "EnablePublicDownloads": true,
      // EnableAdminOperations defaults to true. Exposing /api/admin/* publicly requires an upstream
      // exposure boundary or request throttling; see docs/DEPLOYMENT_HARDENING.md before deploying.
      "EnableAdminOperations": true,
      // EnableUploads inherits EnableAdminOperations when omitted. Set it explicitly to expose or hide
      // the scoped /api/uploads and /api/shares routes independently.
      "EnableUploads": null
    },
    "Cleanup": {
      "CronExpression": "0 */2 * * *",
      // Completed uploads that no share references are reclaimed once they are this old. Configure a
      // retention nothing ever reaches to effectively disable reclamation; there is no on/off switch.
      "UnreferencedUploadRetention": "7.00:00:00"
    },
    "Upload": {
      "MaxBytes": 4294967296
    }
  }
}
